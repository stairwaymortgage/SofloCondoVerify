# Copy to .env.local and fill in. Do not commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://erccluueswqqbukaikut.supabase.co

# Browser-safe publishable key (sb_publishable_... or the legacy anon JWT)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical origin, used for absolute URLs in JSON-LD structured data.
# Falls back to https://soflocondoverify.com when unset.
NEXT_PUBLIC_SITE_URL=https://soflocondoverify.com

# Server-only secret key (sb_secret_... or the legacy service_role JWT).
# Bypasses RLS — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
