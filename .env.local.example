# Copy to .env.local and fill in. Do not commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://erccluueswqqbukaikut.supabase.co

# Browser-safe publishable key (sb_publishable_... or the legacy anon JWT)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical origin. Used for absolute URLs in JSON-LD, the sitemaps,
# robots.txt, and every page's rel=canonical. Falls back to
# https://soflocondoverify.com when unset — set it per environment so a
# preview deploy does not advertise production URLs as its own.
NEXT_PUBLIC_SITE_URL=https://soflocondoverify.com

# GA4 measurement ID (G-XXXXXXXXXX). Set in Vercel, not here.
# Leave blank and analytics switches itself off entirely: no gtag.js
# request, no cookie, and every track() call becomes a no-op.
NEXT_PUBLIC_GA_ID=

# Server-only secret key (sb_secret_... or the legacy service_role JWT).
# Bypasses RLS — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
